wse_table_settings></tab_browse><tab_sql><sql name="Creating view for Dashboard">
Create view sales_frame as 
with panel as (select 
	o.OrderID ,
	o.Date,
	o.CustomerName,
	od.Quantity,
	od.PriceApplied,
	case
		when o.discount != 0 then &quot;Yes&quot;
		else &quot;No&quot;
	end as &quot;Discount Applied?&quot;,
	od.PriceApplied * ((100 - o.discount)/100) * od.Quantity as &quot;TotalIncome&quot;,
	od.CostApplied * od.Quantity as &quot;Totalcost&quot;,
	case
		when o.regular = 0 then &quot;Yes&quot;
		else &quot;No&quot;
	end as &quot;Regular?&quot;
from orders o 
inner join OrderDetails od on od.orderID = o.orderID
inner join Products p on p.ProductId = od.productID
inner join categories c on c.CategoryID = o.Category
right join contact co on co.RedID = o.Contacto
left join regular r on r.ID = o.Regular
left join Shops sh on sh.ID = o.Address
)

select 
	*,
	p.TotalIncome - p.TotalCost as &quot;Profit&quot;
from panel p;


drop view sales_frame;

select * from sales_frame;

select * from orders order by date desc;

delete from Orders where OrderID = &quot;Ord-1797&quot;;
delete from Orders where OrderID = &quot;Ord-1798&quot;;

select * from OrderDetails order by date desc;











</sql><sql name="SQL 2">select * from orders order by date desc;

select * from orderdetails order by OrderDetailsID desc;

